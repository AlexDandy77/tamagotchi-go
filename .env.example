# PostgreSQL administrator password; setup generates a local random value.
POSTGRES_PASSWORD=generated-by-setup
POSTGRES_MAX_CONNECTIONS=250
# Independent service database credentials; setup generates local random values.
USERS_DB_PASSWORD=generated-by-setup
BATTLES_DB_PASSWORD=generated-by-setup
GUILDS_DB_PASSWORD=generated-by-setup
LOCATIONS_DB_PASSWORD=generated-by-setup
RAIDS_DB_PASSWORD=generated-by-setup
TAMAGOTCHI_DB_PASSWORD=generated-by-setup
NOTIFICATION_DB_PASSWORD=generated-by-setup
# MongoDB administrator and Package Registry user passwords; setup generates local random values.
MONGO_ROOT_PASSWORD=generated-by-setup
REGISTRY_DB_PASSWORD=generated-by-setup
# Password for local Alice/Bob fixtures; generated by setup, never committed.
SEED_PASSWORD=generated-by-setup
# Startup checks the latest published release of each service repository.
USER_MANAGEMENT_IMAGE=alexdandy77/pad-team-8-user-management:latest
BATTLE_IMAGE=alexdandy77/pad-team-8-battle:latest
GUILD_IMAGE=xnikug/pad-team-8-guild:latest
PACKAGE_REGISTRY_IMAGE=xnikug/pad-team-8-package-registry:latest
MAP_IMAGE=ralex225/pad-team-8-map:latest
MONSTER_RAID_IMAGE=ralex225/pad-team-8-monster-raid:latest
TAMAGOTCHI_IMAGE=arturtugui/pad-team-8-tamagotchi:latest
NOTIFICATION_IMAGE=arturtugui/pad-team-8-notification:latest
SERVICE_DISCOVERY_IMAGE=alexdandy77/pad-team-8-service-discovery:latest
# Optional: comma-separated user IDs treated as global Package Registry admins (User Management tokens
# carry no admin role yet). Empty by default; put your admin's ID (from GET /v1/users/me) in your local .env.
REGISTRY_ADMIN_USER_IDS=

# Local Kafka SASL identities; setup generates independent random passwords.
KAFKA_BROKER_PASSWORD=generated-by-setup
KAFKA_ADMIN_PASSWORD=generated-by-setup
KAFKA_USERS_PASSWORD=generated-by-setup
KAFKA_BATTLES_PASSWORD=generated-by-setup
KAFKA_GUILDS_PASSWORD=generated-by-setup
KAFKA_REGISTRY_PASSWORD=generated-by-setup
KAFKA_LOCATIONS_PASSWORD=generated-by-setup
KAFKA_RAIDS_PASSWORD=generated-by-setup
KAFKA_TAMAGOTCHI_PASSWORD=generated-by-setup
KAFKA_NOTIFICATION_PASSWORD=generated-by-setup

# Gateway-compatible releases must be published from merged service commits.
GATEWAY_IMAGE=alexdandy77/pad-team-8-gateway:latest
# Required task limits for every service; each owner must implement them before Gateway migration.
GATEWAY_TASK_TIMEOUT_SECONDS=5
GATEWAY_MAX_CONCURRENT_TASKS=64
GATEWAY_MAX_CONCURRENT_SERVICE_TASKS=64
# Only services whose releases support registration belong here; since Lab 3 that is every business service.
DISCOVERY_MANAGED_SERVICES=user-management,battle,guild,package-registry,map,monster-raid,tamagotchi,notification
# Gateway issues single-use socket tickets; Guild's chat socket and Monster Raid's live raid socket require them.
# false returns all three to access tokens.
SOCKET_TICKETS_ENABLED=true
SERVICE_TASK_TIMEOUT_SECONDS=5
SERVICE_MAX_CONCURRENT_TASKS=64

# Service Discovery health alerts: poll interval, critical load threshold and the minimum
# gap between repeats of one alert. Lower LOAD_CRITICAL_PERCENT to demonstrate an alert.
HEALTH_CHECK_INTERVAL_SECONDS=5
LOAD_CRITICAL_PERCENT=80
ALERT_COOLDOWN_SECONDS=60
# Telegram delivery of the alerts to the developers' chat. Put the team bot's token and the
# chat ID only in your local .env; both empty logs the alerts only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Notification's Firebase push: mock logs it; dry-run (validated, not delivered) and live call Firebase and
# need the service-account key at .secrets/fcm/fcm-service-account.json (never committed).
FCM_MODE=mock
