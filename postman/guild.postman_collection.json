{
 "info": {
  "name": "Tamagotchi Go — Guild",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Guild service (localhost:8087) in the Lab 1 Compose deployment. Set seedPassword locally; tokens come from User Management. Runs repeatably: each run creates its own guild. Chat is a WebSocket (ws://localhost:8087/v1/guilds/{{seedGuildId}}/chat): send {\"type\":\"authenticate\",\"accessToken\":\"<token>\"} first, then {\"type\":\"message.send\",\"requestId\":\"<uuid>\",\"content\":\"hi\"}."
 },
 "item": [
  {
   "name": "Login alice",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": "{{users}}/v1/auth/login",
    "body": {
     "mode": "raw",
     "raw": "{\"email\": \"alice@demo.invalid\", \"password\": \"{{seedPassword}}\"}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
       "if(pm.response.code===200){const b=pm.response.json();pm.environment.set(\"aliceToken\",b.accessToken);pm.environment.set(\"aliceId\",b.user.id);}"
      ]
     }
    }
   ]
  },
  {
   "name": "Login bob",
