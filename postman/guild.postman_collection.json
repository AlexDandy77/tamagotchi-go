  {
   "name": "Create guild",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{aliceToken}}"
     },
     {
      "key": "Idempotency-Key",
      "value": "{{createGuildKey}}"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": "{{guild}}/v1/guilds",
    "body": {
     "mode": "raw",
     "raw": "{\"name\": \"Postman Pack\", \"description\": \"Created by the Lab 1 collection\"}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    }
   },
   "event": [
    {
     "listen": "prerequest",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.environment.set(\"createGuildKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
      ]
     }
    },
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
       "if(pm.response.code===201){const b=pm.response.json();pm.environment.set(\"guildId\",b.id);}"
      ]
     }
    }
   ]
  },
