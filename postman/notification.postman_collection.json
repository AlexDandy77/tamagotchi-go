{
  "info": {
    "name": "8. Tamagotchi Go \u2014 Notification service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Gateway player checks use two fresh registered users and real JWTs. Set seedPassword in the local environment and run requests in order. Mark-read is skipped if no Kafka event has created a notification for this user."
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{gateway}}/healthz"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "Register Notification test player",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{users}}/v1/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{notificationRunName}}\",\"email\":\"{{notificationRunEmail}}\",\"password\":\"{{seedPassword}}\",\"packageId\":\"{{packageId}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\").slice(0, 16);",
              "pm.collectionVariables.set(\"notificationRunName\", \"notificationRun_\" + id);",
              "pm.collectionVariables.set(\"notificationRunEmail\", \"notificationRun_\" + id + \"@demo.invalid\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { const s = pm.response.json(); pm.collectionVariables.set(\"notificationToken\", s.accessToken); pm.collectionVariables.set(\"notificationRunUserId\", s.user.id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Register second Notification test player",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{users}}/v1/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{notificationOtherRunName}}\",\"email\":\"{{notificationOtherRunEmail}}\",\"password\":\"{{seedPassword}}\",\"packageId\":\"{{packageId}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\").slice(0, 16);",
              "pm.collectionVariables.set(\"notificationOtherRunName\", \"notif_other_\" + id);",
              "pm.collectionVariables.set(\"notificationOtherRunEmail\", \"notif_other_\" + id + \"@demo.invalid\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { const s = pm.response.json(); pm.collectionVariables.set(\"notificationOtherToken\", s.accessToken); pm.collectionVariables.set(\"notificationOtherRunUserId\", s.user.id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "List notifications",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{notificationToken}}"
          }
        ],
        "url": "{{notification}}/v1/notifications"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.unset(\"notificationRecordId\"); if (pm.response.code === 200) { const s = pm.response.json(); if (s.items[0]) pm.collectionVariables.set(\"notificationRecordId\", s.items[0].id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing auth (401)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{notification}}/v1/notifications"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "List notifications, limit=1",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{notificationToken}}"
          }
        ],
        "url": "{{notification}}/v1/notifications?limit=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "Register device",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{notificationToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{notification}}/v1/notification-devices/{{notificationDeviceId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"token\": \"example-push-token-{{notificationDeviceId}}\", \"platform\": \"android\", \"packageId\": \"{{packageId}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"notificationDeviceId\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "Register same device id as another user (403)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{notificationOtherToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{notification}}/v1/notification-devices/{{notificationDeviceId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"token\": \"example-push-token-{{notificationDeviceId}}\", \"platform\": \"android\", \"packageId\": \"{{packageId}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "Mark notification read",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{notificationToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{notification}}/v1/notifications/{{notificationRecordId}}/read"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// The fresh player may have no delivered events yet.",
              "if (!pm.collectionVariables.get(\"notificationRecordId\")) pm.execution.skipRequest();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "Mark unknown notification read (404)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{notificationToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{notification}}/v1/notifications/00000000-0000-4000-8000-000000000000/read"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "Remove device",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{notificationToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{notification}}/v1/notification-devices/{{notificationDeviceId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "Remove device again (404)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{notificationToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{notification}}/v1/notification-devices/{{notificationDeviceId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "Missing Idempotency-Key (400)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{notificationToken}}"
          }
        ],
        "url": "{{notification}}/v1/notification-devices/{{notificationDeviceId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              ""
            ]
          }
        }
      ]
    }
  ]
}
