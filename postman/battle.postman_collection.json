              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) {",
              "  pm.execution.setNextRequest(null);",
              "} else {",
              "  const state = pm.response.json();",
              "  const deadline = Number(pm.variables.get(\"poll_active_deadline\")) || Date.now() + 30000;",
              "  pm.variables.set(\"poll_active_deadline\", deadline);",
              "  if (state.status === \"preparing\" && Date.now() < deadline) {",
              "    setTimeout(() => pm.execution.setNextRequest(\"Wait for active battle\"), 300);",
              "  } else {",
              "    if (state.status !== \"active\") pm.execution.setNextRequest(null);",
              "    pm.test(\"Battle active\", () => pm.expect(state.status, \"Battle did not reach active within 30 seconds; runner stopped. Check dependency preparation/settlement.\").to.eql(\"active\"));",
