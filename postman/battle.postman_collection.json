{
  "info": {
    "name": "2. Tamagotchi Go \u2014 Battle",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Use the shared local environment and set seedPassword. Before combat, Alice and Bob each need two owned pets and at least 10 available global coins. Obtain extra starters through package enrollment and currency through raids. Run requests in order with a 300 ms delay. Combat changes pet ownership; request IDs and pets are discovered at runtime."
  },
  "item": [
    {
      "name": "Login alice",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{users}}/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"alice@demo.invalid\", \"password\": \"{{seedPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if(pm.response.code===200){const s=pm.response.json();pm.environment.set(\"aliceToken\",s.accessToken);pm.environment.set(\"aliceRefresh\",s.refreshToken);pm.environment.set(\"aliceId\",s.user.id);}"
            ]
          }
        }
      ]
    },
    {
      "name": "Login bob",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{users}}/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"bob@demo.invalid\", \"password\": \"{{seedPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if(pm.response.code===200){const s=pm.response.json();pm.environment.set(\"bobToken\",s.accessToken);pm.environment.set(\"bobRefresh\",s.refreshToken);pm.environment.set(\"bobId\",s.user.id);}"
            ]
          }
        }
      ]
    },
    {
      "name": "Load alice real pets",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aliceToken}}"
          }
        ],
        "url": "{{tamagotchi}}/v1/pets"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.environment.unset(\"alicePrimary\");",
              "pm.environment.unset(\"aliceSecondary\");",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); } else {",
              "  const roster = pm.response.json();",
              "  const owner = pm.environment.get(\"aliceId\");",
              "  const primary = roster.pets.find(p => p.id === roster.primaryPetId && p.ownerId === owner);",
              "  const secondary = roster.pets.find(p => p.id !== roster.primaryPetId && p.ownerId === owner && roster.secondaryPetIds.includes(p.id));",
              "  const valid = Boolean(primary && secondary);",
              "  if (!valid) pm.execution.setNextRequest(null);",
              "  pm.test(\"Alice owns two real pets\", () => pm.expect(valid, \"Battle needs two owned pets. Obtain a second pet through Tamagotchi before running combat; fixture IDs cannot be used in live mode.\").to.eql(true));",
              "  if (valid) {",
              "    pm.environment.set(\"alicePrimary\", primary.id);",
              "    pm.environment.set(\"aliceSecondary\", secondary.id);",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Check alice battle funds",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aliceToken}}"
          }
        ],
        "url": "{{users}}/v1/wallet"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); } else {",
              "  const funded = pm.response.json().globalAvailable >= 10;",
              "  if (!funded) pm.execution.setNextRequest(null);",
              "  pm.test(\"Enough available currency for the stake\", () => pm.expect(funded, \"Earn at least 10 available global coins through raids before battling.\").to.eql(true));",
              "}"
            ]
          }
        }
      ]
    },
