    {
      "name": "Wait for active battle",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aliceToken}}"
          }
        ],
        "url": "{{battle}}/v1/battles/{{battleId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) {",
              "  pm.execution.setNextRequest(null);",
              "} else {",
              "  const state = pm.response.json();",
              "  const attempts = Number(pm.variables.get(\"poll_active\") || 0) + 1;",
              "  pm.variables.set(\"poll_active\", attempts);",
              "  if (state.status === \"preparing\" && attempts < 30) {",
              "    pm.execution.setNextRequest(\"Wait for active battle\");",
              "  } else {",
              "    if (state.status !== \"active\") pm.execution.setNextRequest(null);",
              "    pm.test(\"Battle active\", () => pm.expect(state.status, \"Battle did not reach active; runner stopped. Check dependency preparation/settlement and use a 300 ms runner delay.\").to.eql(\"active\"));",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
