              "  const owner = pm.environment.get(\"bobId\");",
              "  const primary = roster.pets.find(p => p.id === roster.primaryPetId && p.ownerId === owner);",
              "  const secondary = roster.pets.find(p => p.id !== roster.primaryPetId && p.ownerId === owner && roster.secondaryPetIds.includes(p.id));",
              "  const valid = Boolean(primary && secondary);",
