              "  pm.test(\"Bob owns two real pets\", () => pm.expect(valid, \"Battle needs two owned pets. Obtain a second pet through Tamagotchi before running combat; fixture IDs cannot be used in live mode.\").to.eql(true));",
              "  if (valid) {",
              "    pm.environment.set(\"bobPrimary\", primary.id);",
              "    pm.environment.set(\"bobSecondary\", secondary.id);",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
