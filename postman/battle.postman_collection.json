{
  "info": {
    "name": "2. Tamagotchi Go \u2014 Battle",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Use the shared local environment and set seedPassword. When Alice or Bob has fewer than two pets, the collection enrolls them in another configured active package and waits for real starter provisioning. Each player still needs at least 10 available global coins, earned through raids. Run requests in order; state polling includes its own 300 ms pause and a 30-second deadline. Combat changes pet ownership; request IDs and pets are discovered at runtime. If a previous capture cleared the primary selection, this collection selects an owned pet before challenging."
  },
  "item": [
    {
      "name": "Login alice",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{users}}/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"alice@demo.invalid\", \"password\": \"{{seedPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if(pm.response.code===200){const s=pm.response.json();pm.environment.set(\"aliceToken\",s.accessToken);pm.environment.set(\"aliceRefresh\",s.refreshToken);pm.environment.set(\"aliceId\",s.user.id);}"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.unset(\"aliceStarterPending\");",
              "pm.variables.unset(\"aliceStarterDeadline\");"
            ]
          }
        }
      ]
    },
    {
      "name": "Login bob",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{users}}/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"bob@demo.invalid\", \"password\": \"{{seedPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if(pm.response.code===200){const s=pm.response.json();pm.environment.set(\"bobToken\",s.accessToken);pm.environment.set(\"bobRefresh\",s.refreshToken);pm.environment.set(\"bobId\",s.user.id);}"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.unset(\"bobStarterPending\");",
              "pm.variables.unset(\"bobStarterDeadline\");"
            ]
          }
        }
      ]
    },
    {
      "name": "Load alice real pets",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aliceToken}}"
          }
        ],
        "url": "{{tamagotchi}}/v1/pets"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.environment.unset(\"alicePrimary\");",
              "pm.environment.unset(\"aliceSecondary\");",
              "pm.environment.unset(\"aliceNeedsPrimary\");",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); } else {",
              "  const roster = pm.response.json();",
              "  const owner = pm.environment.get(\"aliceId\");",
              "  const owned = roster.pets.filter(p => p.ownerId === owner);",
              "  pm.variables.set(\"aliceOwnedCount\", owned.length);",
              "  const pending = pm.variables.get(\"aliceStarterPending\");",
              "  if (pending !== undefined && owned.length > Number(pending)) pm.variables.unset(\"aliceStarterPending\");",
              "  if (owned.length < 2) {",
              "    const deadline = Number(pm.variables.get(\"aliceStarterDeadline\")) || Date.now() + 30000;",
              "    pm.variables.set(\"aliceStarterDeadline\", deadline);",
              "    if (Date.now() >= deadline) {",
              "      pm.test(\"Alice owns two real pets\", () => pm.expect(owned.length, \"Starter provisioning did not supply two pets within 30 seconds.\").to.be.at.least(2));",
              "      pm.execution.setNextRequest(null);",
              "    } else if (pm.variables.get(\"aliceStarterPending\") !== undefined) {",
              "      setTimeout(() => pm.execution.setNextRequest(\"Load alice real pets\"), 300);",
              "    } else {",
              "      pm.execution.setNextRequest(\"Read alice package enrollments\");",
              "    }",
              "  } else {",
              "  const selected = owned.find(p => p.id === roster.primaryPetId);",
              "  const primary = selected || owned[0];",
              "  const secondary = owned.find(p => p.id !== primary?.id && roster.secondaryPetIds.includes(p.id));",
              "  const valid = Boolean(primary && secondary);",
              "  if (!valid) pm.execution.setNextRequest(null);",
              "  pm.test(\"Alice owns two real pets\", () => pm.expect(valid, \"Battle needs two owned pets. Obtain a second pet through Tamagotchi before running combat; fixture IDs cannot be used in live mode.\").to.eql(true));",
              "  if (valid) {",
              "    pm.environment.set(\"aliceNeedsPrimary\", String(!selected));",
              "    pm.environment.set(\"alicePrimary\", primary.id);",
              "    pm.environment.set(\"aliceSecondary\", secondary.id);",
              "    pm.execution.setNextRequest(\"Select alice primary if missing\");",
              "  }",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Read alice package enrollments",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aliceToken}}"
          }
        ],
        "url": "{{users}}/v1/users/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); } else {",
              "  pm.variables.set(\"alicePackageIds\", pm.response.json().packageIds);",
              "  pm.variables.set(\"aliceStarterPackageUrl\", pm.environment.get(\"registry\") + \"/v1/packages?limit=100\");",
              "  pm.variables.set(\"aliceStarterPages\", 0);",
              "  pm.variables.unset(\"aliceStarterPackage\");",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Find alice new starter package",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aliceToken}}"
          }
        ],
        "url": "{{aliceStarterPackageUrl}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); } else {",
              "  const page = pm.response.json();",
              "  const enrolled = new Set(pm.variables.get(\"alicePackageIds\"));",
              "  const candidate = page.items.find(p => p.status === \"active\" && p.configVersion !== null && !enrolled.has(p.id));",
              "  const pages = Number(pm.variables.get(\"aliceStarterPages\")) + 1;",
              "  pm.variables.set(\"aliceStarterPages\", pages);",
              "  if (candidate) {",
              "    pm.variables.set(\"aliceStarterPackage\", candidate.id);",
              "  } else if (page.nextCursor && pages < 20 && Date.now() < Number(pm.variables.get(\"aliceStarterDeadline\"))) {",
              "    pm.variables.set(\"aliceStarterPackageUrl\", pm.environment.get(\"registry\") + \"/v1/packages?limit=100&cursor=\" + encodeURIComponent(page.nextCursor));",
              "    pm.execution.setNextRequest(\"Find alice new starter package\");",
              "  } else {",
              "    pm.test(\"Unenrolled active package available\", () => pm.expect(candidate, \"Publish another configured active package. Existing enrollments cannot recreate captured starters.\").to.be.an(\"object\"));",
              "    pm.execution.setNextRequest(null);",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Enroll alice for a new starter",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aliceToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{users}}/v1/users/me/packages/{{aliceStarterPackage}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); } else {",
              "  pm.variables.set(\"aliceStarterPending\", pm.variables.get(\"aliceOwnedCount\"));",
              "  setTimeout(() => pm.execution.setNextRequest(\"Load alice real pets\"), 300);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Select alice primary if missing",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aliceToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{tamagotchi}}/v1/pets/primary",
        "body": {
          "mode": "raw",
          "raw": "{\"petId\":\"{{alicePrimary}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.environment.get(\"aliceNeedsPrimary\") !== \"true\") pm.execution.skipRequest();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); } else {",
              "  const roster = pm.response.json();",
              "  const primary = pm.environment.get(\"alicePrimary\");",
              "  const secondary = pm.environment.get(\"aliceSecondary\");",
              "  const owner = pm.environment.get(\"aliceId\");",
              "  const owned = new Set(roster.pets.filter(p => p.ownerId === owner).map(p => p.id));",
              "  const valid = roster.primaryPetId === primary && primary !== secondary && owned.has(primary) && owned.has(secondary) && roster.secondaryPetIds.includes(secondary);",
              "  pm.test(\"Owned battle loadout confirmed\", () => pm.expect(valid).to.eql(true));",
              "  if (!valid) pm.execution.setNextRequest(null);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Check alice battle funds",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aliceToken}}"
          }
        ],
        "url": "{{users}}/v1/wallet"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
