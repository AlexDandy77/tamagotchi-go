    {
      "name": "Challenge to cancel",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aliceToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{battle}}/v1/battles",
        "body": {
          "mode": "raw",
          "raw": "{\"opponentId\": \"{{bobId}}\", \"primaryPetId\": \"{{alicePrimary}}\", \"secondaryPetId\": \"{{aliceSecondary}}\", \"boostIds\": []}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if(pm.response.code===201)pm.environment.set(\"battleId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Cancel challenge",
      "request": {
        "method": "DELETE",
        "header": [
