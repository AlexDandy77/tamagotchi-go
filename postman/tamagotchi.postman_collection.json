    {
      "name": "Internal routes (mTLS)",
      "description": "Opt-in integration checks for Tamagotchi\u2019s existing internal routes. These are real handlers, not the player-route mock mode, and require the internal listener and a trusted caller certificate. 1) Use a Tamagotchi image that includes the internal mTLS listener (the local `.env` was observed pointing to `arturtugui/pad-team-8-tamagotchi:0.4.1`; update `TAMAGOTCHI_IMAGE` to the published `2.0.0` or `latest` image first). 2) Run `python3 scripts/lab.py setup` if local TLS material has not been created. 3) Start/recreate Tamagotchi with `docker compose -f compose.yaml -f compose.postman.internal.yaml up -d tamagotchi`. The override binds only to 127.0.0.1. 4) In Postman Settings \u2192 Certificates, add host `localhost` for ports 18443, 18444, and 18445. Map them respectively to `.secrets/tls/user-management.pem` + `user-management-key.pem`, `battle.pem` + `battle-key.pem`, and `monster-raid.pem` + `monster-raid-key.pem`. Trust `.secrets/tls/ca.pem` as the local CA. Do not disable TLS verification. Run this folder\u2019s requests in order; they generate fresh UUIDs. Running the entire collection also runs this folder, so omit/deselect it when you only want the player-route baseline.",
      "item": [
        {
          "name": "Provision starter pet (User Management)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{internalIdempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{tamagotchiInternalUserManagement}}/internal/v1/starter-pets/{{internalStarterOperationId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{internalStarterUserId}}\",\n  \"packageId\": \"{{packageId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"internalStarterUserId\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.environment.set(\"internalStarterOperationId\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.environment.set(\"internalIdempotencyKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { pm.environment.set(\"internalStarterPetId\", pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Reserve battle pets (Battle)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{internalIdempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{tamagotchiInternalBattle}}/internal/v1/pet-reservations/{{internalBattleId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"battle\",\n  \"users\": [\n    { \"userId\": \"{{devToken}}\", \"primaryPetId\": \"{{emberlingId}}\", \"secondaryPetId\": \"{{rippletId}}\" },\n    { \"userId\": \"{{internalStarterUserId}}\", \"primaryPetId\": \"{{internalStarterPetId}}\", \"secondaryPetId\": null }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"internalBattleId\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.environment.set(\"internalIdempotencyKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.test(\"reservation is active\", () => pm.expect(pm.response.json().status).to.eql(\"reserved\"));"
                ]
              }
            }
          ]
        },
