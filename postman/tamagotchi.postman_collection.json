            ]
          }
        }
      ]
    },
    {
      "name": "Care: feed",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{devToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{tamagotchi}}/v1/pets/{{emberlingId}}/care",
        "body": {
          "mode": "raw",
          "raw": "{\"actionId\": \"feed\", \"expectedVersion\": {{petVersion}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if(pm.response.code===200){const s=pm.response.json();pm.environment.set(\"careActionInstanceId\", s.actionInstanceId); pm.environment.set(\"petVersion\", s.pet.version);}"
            ]
          }
        }
      ]
    },
