{
  "info": {
    "name": "Tamagotchi Go \u2014 Tamagotchi service (Artur)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Player routes for the Tamagotchi service. Runs against the team stack (`python3 scripts/lab.py up`, port 8085) or a locally started service. Auth is mocked: the bearer token is the user id, so devToken is the seeded demo user 77777777-7777-4777-8777-777777777777 and otherDevToken a user with no pets. Internal routes are not here: in the team stack they are served only over mTLS inside the Compose network."
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{tamagotchi}}/healthz"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "Pet types",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{devToken}}"
          }
        ],
        "url": "{{tamagotchi}}/v1/pet-types"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "Pets roster",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{devToken}}"
          }
        ],
        "url": "{{tamagotchi}}/v1/pets"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "Missing auth (401)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{tamagotchi}}/v1/pets"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "Get primary pet",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{devToken}}"
          }
        ],
        "url": "{{tamagotchi}}/v1/pets/{{emberlingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if(pm.response.code===200){const s=pm.response.json();pm.environment.set(\"petVersion\", s.version);}"
            ]
          }
        }
      ]
    },
    {
      "name": "Get unknown pet (404)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{devToken}}"
          }
        ],
        "url": "{{tamagotchi}}/v1/pets/00000000-0000-4000-8000-000000000000"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "Select primary",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{devToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{tamagotchi}}/v1/pets/primary",
        "body": {
          "mode": "raw",
          "raw": "{\"petId\": \"{{rippletId}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "Select primary back",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{devToken}}"
          },
          {
            "key": "Idempotency-Key",
