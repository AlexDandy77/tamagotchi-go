    ],
    "url": "{{map}}/v1/map/location",
    "body": {
     "mode": "raw",
     "raw": "{\"latitude\": 47.0617, \"longitude\": 28.8683, \"accuracyMeters\": 3, \"recordedAt\": \"{{recordedAt}}\"}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    }
   },
   "event": [
    {
     "listen": "prerequest",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.environment.set(\"recordedAt\", new Date(Date.now() - 60000).toISOString());"
