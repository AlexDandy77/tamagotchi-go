{
 "info": {
  "name": "Tamagotchi Go — Map",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Map service (localhost:8083) in the Lab 1 Compose deployment. Set seedPassword locally; tokens and relationships come from User Management. Runs repeatably: it clears both locations, makes Alice and Bob strangers, then enemies, then friends again as seeded. Current reports are dated 5 s ahead: Map accepts up to 30 s of clock skew, and the margin keeps them newer than a clear when the Docker clock runs slightly ahead of the host."
 },
 "item": [
  {
   "name": "Login alice",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": "{{users}}/v1/auth/login",
    "body": {
     "mode": "raw",
     "raw": "{\"email\": \"alice@demo.invalid\", \"password\": \"{{seedPassword}}\"}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
       "if(pm.response.code===200){const b=pm.response.json();pm.environment.set(\"aliceToken\",b.accessToken);pm.environment.set(\"aliceId\",b.user.id);}"
      ]
     }
    }
   ]
  },
