{
 "info": {
  "name": "Tamagotchi Go — Package Registry",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Package Registry (localhost:8088) in the Lab 1 Compose deployment. Set seedPassword locally. Before running, set REGISTRY_ADMIN_USER_IDS in your local .env to Alice's user ID so she is a global admin; Bob moderates the seeded package. Runs repeatably: each run registers its own package, monster and schedule."
 },
 "item": [
  {
   "name": "Login alice",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": "{{users}}/v1/auth/login",
    "body": {
     "mode": "raw",
     "raw": "{\"email\": \"alice@demo.invalid\", \"password\": \"{{seedPassword}}\"}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
       "if(pm.response.code===200){const b=pm.response.json();pm.environment.set(\"aliceToken\",b.accessToken);pm.environment.set(\"aliceId\",b.user.id);}"
      ]
     }
    }
   ]
  },
