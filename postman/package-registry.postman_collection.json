  {
   "name": "Schedule a raid for the seeded guild",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{aliceToken}}"
     },
     {
      "key": "Idempotency-Key",
      "value": "{{$guid}}"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": "{{registry}}/v1/raid-schedules",
    "body": {
     "mode": "raw",
     "raw": "{\"guildId\": \"{{seedGuildId}}\", \"monsterId\": \"{{monsterId}}\", \"monsterVersion\": 1, \"startsAt\": \"{{raidStartsAt}}\", \"durationSeconds\": 900, \"participantLimit\": 20, \"rewards\": {\"globalCurrencyPerParticipant\": 20, \"xpPerParticipant\": 50}}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    }
   },
   "event": [
    {
     "listen": "prerequest",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.environment.set(\"raidStartsAt\", new Date(Date.now() + 60 * 60 * 1000).toISOString());"
      ]
     }
    },
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
       "if(pm.response.code===201){const b=pm.response.json();pm.environment.set(\"scheduleId\",b.id);}",
       "pm.test(\"pending dispatch\", () => pm.expect(pm.response.json().dispatchStatus).to.eql(\"pending\"));"
      ]
     }
    }
   ]
