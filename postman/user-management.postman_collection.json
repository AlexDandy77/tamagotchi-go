{
  "info": {
    "name": "1. Tamagotchi Go \u2014 User Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Select the shared local environment and set seedPassword locally. Runs authentication, profile, wallet, enrollment and relationship requests against seeded Alice/Bob accounts."
  },
  "item": [
    {
      "name": "Login alice",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{users}}/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"alice@demo.invalid\", \"password\": \"{{seedPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if(pm.response.code===200){const s=pm.response.json();pm.environment.set(\"aliceToken\",s.accessToken);pm.environment.set(\"aliceRefresh\",s.refreshToken);pm.environment.set(\"aliceId\",s.user.id);}"
            ]
          }
        }
      ]
    },
