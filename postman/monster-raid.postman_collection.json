   "name": "Reject an attack by a member who did not join",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{bobToken}}"
     },
     {
      "key": "Idempotency-Key",
      "value": "{{$guid}}"
     }
    ],
    "url": "{{monsterRaid}}/v1/raids/{{practiceRaidId}}/attacks"
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 403\", () => pm.expect(pm.response.code).to.eql(403));",
       "pm.test(\"NOT_PARTICIPANT\", () => pm.expect(pm.response.json().error.code).to.eql(\"NOT_PARTICIPANT\"));"
      ]
     }
    }
   ]
  },
  {
   "name": "Alice attacks",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{aliceToken}}"
     },
     {
      "key": "Idempotency-Key",
      "value": "{{attackKey}}"
     }
    ],
    "url": "{{monsterRaid}}/v1/raids/{{practiceRaidId}}/attacks"
   },
   "event": [
    {
     "listen": "prerequest",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.environment.set(\"attackKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
      ]
     }
    },
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 200\", () => pm.expect(pm.response.code).to.eql(200));",
       "const b = pm.response.json();",
       "pm.test(\"The monster lost HP\", () => pm.expect(b.hp).to.be.below(Number(pm.environment.get(\"hpBefore\"))));",
       "if(pm.response.code===200)pm.environment.set(\"hpAfter\",b.hp);"
      ]
     }
    }
   ]
  },
  {
   "name": "Replay the attack with the same key",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{aliceToken}}"
     },
     {
      "key": "Idempotency-Key",
      "value": "{{attackKey}}"
     }
    ],
    "url": "{{monsterRaid}}/v1/raids/{{practiceRaidId}}/attacks"
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 200\", () => pm.expect(pm.response.code).to.eql(200));",
       "pm.test(\"Replays the stored outcome\", () => { pm.expect(pm.response.headers.get(\"Idempotent-Replayed\")).to.eql(\"true\"); pm.expect(pm.response.json().hp).to.eql(Number(pm.environment.get(\"hpAfter\"))); });"
      ]
     }
    }
   ]
  },
  {
   "name": "Reject an attack within the cooldown",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{aliceToken}}"
     },
     {
      "key": "Idempotency-Key",
      "value": "{{$guid}}"
     }
    ],
    "url": "{{monsterRaid}}/v1/raids/{{practiceRaidId}}/attacks"
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 429\", () => pm.expect(pm.response.code).to.eql(429));",
       "pm.test(\"ATTACK_COOLDOWN\", () => pm.expect(pm.response.json().error.code).to.eql(\"ATTACK_COOLDOWN\"));",
       "pm.test(\"Says when to retry\", () => pm.expect(Number(pm.response.headers.get(\"Retry-After\"))).to.be.above(0));"
      ]
     }
    }
   ]
  },
  {
   "name": "Reject attack without Idempotency-Key",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{aliceToken}}"
     }
    ],
    "url": "{{monsterRaid}}/v1/raids/{{practiceRaidId}}/attacks"
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 400\", () => pm.expect(pm.response.code).to.eql(400));",
       "pm.test(\"IDEMPOTENCY_KEY_REQUIRED\", () => pm.expect(pm.response.json().error.code).to.eql(\"IDEMPOTENCY_KEY_REQUIRED\"));"
      ]
     }
    }
   ]
  },
  {
   "name": "Reject the attack's key on another request",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{aliceToken}}"
     },
     {
      "key": "Idempotency-Key",
      "value": "{{attackKey}}"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": "{{monsterRaid}}/v1/raids/{{practiceRaidId}}/participants",
    "body": {
     "mode": "raw",
     "raw": "{\"primaryPetId\": \"{{alicePrimary}}\"}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 409\", () => pm.expect(pm.response.code).to.eql(409));",
       "pm.test(\"IDEMPOTENCY_CONFLICT\", () => pm.expect(pm.response.json().error.code).to.eql(\"IDEMPOTENCY_CONFLICT\"));"
      ]
     }
    }
   ]
  },
