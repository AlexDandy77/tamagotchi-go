{
 "info": {
  "name": "6. Tamagotchi Go — Monster Raid",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Monster Raid through Gateway. Set seedPassword locally; seeded Alice must be a Registry admin and Alice/Bob members of the seeded guild. Each run creates its own practice monster and raid schedule through Registry, waits for real dispatch, tests join/attack errors and replay, then cancels the schedule and waits for reservation release. The won fixture remains unchanged. Run the complete collection so cleanup executes; IDs for the new raid stay local to this run."
 },
 "item": [
  {
   "name": "Login alice",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": "{{users}}/v1/auth/login",
    "body": {
     "mode": "raw",
     "raw": "{\"email\": \"alice@demo.invalid\", \"password\": \"{{seedPassword}}\"}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 200\", () => pm.expect(pm.response.code).to.eql(200));",
       "if(pm.response.code===200){const b=pm.response.json();pm.environment.set(\"aliceToken\",b.accessToken);pm.environment.set(\"aliceId\",b.user.id);}"
      ]
     }
    },
    {
     "listen": "prerequest",
     "script": {
      "type": "text/javascript",
      "exec": [
       "for (const key of [\"raidRunPracticeId\", \"raidRunMonsterId\", \"raidRunScheduleVersion\", \"raidRunActiveDeadline\", \"raidRunCleanupDeadline\", \"raidRunListCursor\", \"raidRunListPages\", \"raidRunSeenPractice\", \"raidRunSeenFixture\"]) pm.variables.unset(key);"
      ]
     }
    }
   ]
  },
  {
   "name": "Login bob",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": "{{users}}/v1/auth/login",
    "body": {
     "mode": "raw",
     "raw": "{\"email\": \"bob@demo.invalid\", \"password\": \"{{seedPassword}}\"}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 200\", () => pm.expect(pm.response.code).to.eql(200));",
       "if(pm.response.code===200){const b=pm.response.json();pm.environment.set(\"bobToken\",b.accessToken);pm.environment.set(\"bobId\",b.user.id);}"
      ]
     }
    }
   ]
  },
  {
   "name": "Read Alice's primary pet",
   "request": {
    "method": "GET",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{aliceToken}}"
     }
    ],
    "url": "{{tamagotchi}}/v1/pets"
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
       "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); } else {",
       "  const roster = pm.response.json();",
       "  const owned = roster.pets.filter(p => p.ownerId === pm.environment.get(\"aliceId\"));",
       "  const selected = owned.find(p => p.id === roster.primaryPetId);",
       "  const primary = selected || owned[0];",
       "  pm.test(\"Alice has an owned pet for the raid\", () => pm.expect(primary).to.be.an(\"object\"));",
       "  if (!primary) { pm.execution.setNextRequest(null); } else {",
       "    pm.variables.set(\"raidRunPrimary\", primary.id);",
       "    pm.variables.set(\"raidRunNeedsPrimary\", String(!selected));",
       "  }",
       "}"
      ]
     }
    }
   ]
  },
  {
   "name": "Select Alice's raid primary if missing",
   "request": {
    "method": "PUT",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{aliceToken}}"
     },
     {
      "key": "Idempotency-Key",
      "value": "{{$guid}}"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": "{{tamagotchi}}/v1/pets/primary",
    "body": {
     "mode": "raw",
     "raw": "{\"petId\":\"{{raidRunPrimary}}\"}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    }
   },
   "event": [
    {
     "listen": "prerequest",
     "script": {
      "type": "text/javascript",
      "exec": [
       "if (pm.variables.get(\"raidRunNeedsPrimary\") !== \"true\") pm.execution.skipRequest();"
      ]
     }
    },
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
       "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); } else {",
       "  pm.test(\"Owned primary selected\", () => pm.expect(pm.response.json().primaryPetId).to.eql(pm.variables.get(\"raidRunPrimary\")));",
       "}"
      ]
     }
    }
   ]
  },
