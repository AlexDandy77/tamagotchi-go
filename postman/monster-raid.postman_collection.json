  {
   "name": "Create this run's practice monster",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{aliceToken}}"
     },
     {
      "key": "Idempotency-Key",
      "value": "{{$guid}}"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": "{{registry}}/v1/monsters",
    "body": {
     "mode": "raw",
     "raw": "{\"name\":\"Postman practice {{$guid}}\",\"description\":\"Per-run combat checks; cancelled during cleanup\",\"spriteUrls\":[\"https://example.invalid/practice.png\"],\"maxHp\":1000000,\"baseAttack\":0,\"weaknesses\":[],\"resistances\":[],\"specialProperties\":[\"none\"]}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
       "if (pm.response.code !== 201) { pm.execution.setNextRequest(null); } else {",
       "  pm.variables.set(\"raidRunMonsterId\", pm.response.json().id);",
       "  pm.variables.set(\"raidRunMonsterVersion\", pm.response.json().version);",
       "}"
      ]
     }
    }
   ]
  },
  {
   "name": "Schedule this run's practice raid",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{aliceToken}}"
     },
     {
      "key": "Idempotency-Key",
      "value": "{{$guid}}"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": "{{registry}}/v1/raid-schedules",
    "body": {
     "mode": "raw",
     "raw": "{\"guildId\":\"{{seedGuildId}}\",\"monsterId\":\"{{raidRunMonsterId}}\",\"monsterVersion\":{{raidRunMonsterVersion}},\"startsAt\":\"{{raidRunStartsAt}}\",\"durationSeconds\":300,\"participantLimit\":20,\"rewards\":{\"globalCurrencyPerParticipant\":0,\"xpPerParticipant\":0}}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    }
   },
   "event": [
    {
     "listen": "prerequest",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.variables.set(\"raidRunStartsAt\", new Date(Date.now() + 3000).toISOString());"
      ]
     }
    },
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
       "if (pm.response.code !== 201) { pm.execution.setNextRequest(null); } else {",
       "  pm.variables.set(\"raidRunPracticeId\", pm.response.json().id);",
       "  pm.variables.set(\"raidRunScheduleVersion\", pm.response.json().version);",
       "  pm.variables.set(\"raidRunActiveDeadline\", Date.now() + 30000);",
       "}"
      ]
     }
    }
   ]
  },
  {
   "name": "Wait for this run's practice raid",
   "request": {
    "method": "GET",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{aliceToken}}"
     }
    ],
    "url": "{{monsterRaid}}/v1/raids/{{raidRunPracticeId}}"
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "const body = pm.response.code === 200 ? pm.response.json() : {};",
       "const active = body.status === \"active\" && Date.parse(body.startsAt) <= Date.now();",
       "if ((pm.response.code === 404 || body.status === \"settling\" || (body.status === \"active\" && !active)) && Date.now() < Number(pm.variables.get(\"raidRunActiveDeadline\"))) {",
       "  setTimeout(() => pm.execution.setNextRequest(\"Wait for this run's practice raid\"), 300);",
       "} else {",
       "  pm.test(\"Practice raid dispatched\", () => pm.response.to.have.status(200));",
       "  pm.test(\"Practice raid active\", () => pm.expect(active, \"Registry dispatch did not create an active practice raid within 30 seconds\").to.eql(true));",
       "  if (!active) pm.execution.setNextRequest(\"Read practice schedule before cleanup\");",
       "}"
      ]
     }
    }
   ]
  },
  {
   "name": "List Night Owls raids",
   "request": {
    "method": "GET",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{aliceToken}}"
     }
    ],
    "url": "{{raidRunListUrl}}"
   },
   "event": [
    {
     "listen": "prerequest",
     "script": {
      "type": "text/javascript",
      "exec": [
       "let url = pm.environment.get(\"monsterRaid\") + \"/v1/raids?guildId=\" + pm.environment.get(\"seedGuildId\") + \"&limit=100\";",
       "if (pm.variables.get(\"raidRunListCursor\")) url += \"&cursor=\" + encodeURIComponent(pm.variables.get(\"raidRunListCursor\"));",
       "pm.variables.set(\"raidRunListUrl\", url);"
      ]
     }
    },
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
       "if (pm.response.code !== 200) { pm.execution.setNextRequest(\"Read practice schedule before cleanup\"); } else {",
       "  const page = pm.response.json();",
       "  const practice = page.items.find(r => r.id === pm.variables.get(\"raidRunPracticeId\"));",
       "  const fixture = page.items.find(r => r.id === pm.environment.get(\"fixtureRaidId\"));",
       "  if (practice) pm.variables.set(\"raidRunSeenPractice\", practice);",
       "  if (fixture) pm.variables.set(\"raidRunSeenFixture\", fixture);",
       "  const pages = Number(pm.variables.get(\"raidRunListPages\") || 0) + 1;",
       "  pm.variables.set(\"raidRunListPages\", pages);",
       "  if ((!pm.variables.get(\"raidRunSeenPractice\") || !pm.variables.get(\"raidRunSeenFixture\")) && page.nextCursor && pages < 20) {",
       "    pm.variables.set(\"raidRunListCursor\", page.nextCursor);",
       "    pm.execution.setNextRequest(\"List Night Owls raids\");",
       "  } else {",
       "    pm.test(\"Lists the open practice raid\", () => { const r = pm.variables.get(\"raidRunSeenPractice\"); pm.expect(r).to.be.an(\"object\"); pm.expect(r.status).to.eql(\"active\"); pm.expect(r.guildId).to.eql(pm.environment.get(\"seedGuildId\")); });",
       "    pm.test(\"Lists the won fixture raid\", () => { const r = pm.variables.get(\"raidRunSeenFixture\"); pm.expect(r).to.be.an(\"object\"); pm.expect(r.status).to.eql(\"won\"); pm.expect(r.settlement).to.eql(\"complete\"); });",
       "  }",
       "}"
      ]
     }
    }
   ]
  },
