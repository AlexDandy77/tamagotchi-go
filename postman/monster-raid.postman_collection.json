  {
   "name": "List Night Owls raids",
   "request": {
    "method": "GET",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{aliceToken}}"
     }
    ],
    "url": "{{monsterRaid}}/v1/raids?guildId={{seedGuildId}}"
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 200\", () => pm.expect(pm.response.code).to.eql(200));",
       "const items = pm.response.json().items;",
       "const practice = items.find(r => r.id === pm.environment.get(\"practiceRaidId\"));",
       "const fixture = items.find(r => r.id === pm.environment.get(\"fixtureRaidId\"));",
       "pm.test(\"Lists the open practice raid\", () => { pm.expect(practice).to.be.an(\"object\"); pm.expect(practice.status).to.eql(\"active\"); pm.expect(practice.guildId).to.eql(pm.environment.get(\"seedGuildId\")); });",
       "pm.test(\"Lists the won fixture raid\", () => { pm.expect(fixture).to.be.an(\"object\"); pm.expect(fixture.status).to.eql(\"won\"); pm.expect(fixture.settlement).to.eql(\"complete\"); });"
      ]
     }
    }
   ]
  },
  {
   "name": "List one raid per page",
   "request": {
    "method": "GET",
