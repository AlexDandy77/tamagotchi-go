    ],
    "url": "{{monsterRaid}}/v1/raids?guildId={{seedGuildId}}&limit=1"
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 200\", () => pm.expect(pm.response.code).to.eql(200));",
       "const b = pm.response.json();",
       "pm.test(\"One raid and a cursor to the next page\", () => { pm.expect(b.items).to.have.lengthOf(1); pm.expect(b.nextCursor).to.be.a(\"string\").and.not.empty; });",
       "if(pm.response.code===200){pm.environment.set(\"raidCursor\",b.nextCursor);pm.environment.set(\"firstRaidId\",b.items[0].id);}"
      ]
     }
    }
   ]
  },
