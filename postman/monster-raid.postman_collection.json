     "script": {
      "type": "text/javascript",
      "exec": [
       "const body = pm.response.code === 200 ? pm.response.json() : {};",
       "const complete = pm.response.code === 200 && body.status === \"cancelled\" && body.settlement === \"complete\";",
       "if (!complete && Date.now() < Number(pm.variables.get(\"raidRunCleanupDeadline\"))) {",
       "  setTimeout(() => pm.execution.setNextRequest(\"Wait for practice raid cancellation and release\"), 300);",
       "} else {",
       "  pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
       "  pm.test(\"Raid cancelled and reservations released\", () => { pm.expect(body.status).to.eql(\"cancelled\"); pm.expect(body.settlement).to.eql(\"complete\"); });",
