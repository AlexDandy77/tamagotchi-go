{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tamagotchi Go realtime frames v1: guild chat and live raids",
  "oneOf": [
    {
      "$ref": "#/$defs/ChatAuthenticate"
    },
    {
      "$ref": "#/$defs/ChatAuthenticated"
    },
    {
      "$ref": "#/$defs/ChatSend"
    },
    {
      "$ref": "#/$defs/ChatAck"
    },
    {
      "$ref": "#/$defs/ChatCreated"
    },
    {
      "$ref": "#/$defs/ChatError"
    },
    {
      "$ref": "#/$defs/RaidAuthenticate"
    },
    {
      "$ref": "#/$defs/RaidState"
    },
    {
      "$ref": "#/$defs/RaidError"
    }
  ],
  "$defs": {
    "ChatAuthenticate": {
      "description": "First client frame, before any chat data. With socket tickets, accessToken carries the Gateway's single-use socket ticket instead of the player's access token. Do not persist or echo it.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "authenticate"
          ]
        },
        "accessToken": {
          "type": "string",
          "writeOnly": true
        }
      },
      "required": [
        "type",
        "accessToken"
      ]
    },
    "ChatAuthenticated": {
      "description": "Server confirms membership and current sequence; replay uses REST.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "authenticated"
          ]
        },
        "guildId": {
          "$ref": "#/$defs/ID"
        },
        "userId": {
          "$ref": "#/$defs/ID"
        },
        "latestSequence": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "guildId",
        "userId",
        "latestSequence"
      ]
    },
    "ID": {
      "type": "string",
      "format": "uuid",
      "description": "UUID string identifying an existing resource."
    },
    "ChatSend": {
      "description": "Client frame. requestId is also its deduplication key within the guild/user.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "message.send"
          ]
        },
        "requestId": {
          "$ref": "#/$defs/ID"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "type",
        "requestId",
        "content"
      ]
    },
    "ChatAck": {
      "description": "Server replies to the sender after durable persistence.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "message.ack"
          ]
        },
        "requestId": {
          "$ref": "#/$defs/ID"
        },
        "message": {
          "$ref": "#/$defs/ChatMessage"
        }
      },
      "required": [
        "type",
        "requestId",
        "message"
      ]
    },
    "ChatMessage": {
      "description": "Sequence is monotonically increasing within a guild.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/ID"
        },
        "guildId": {
          "$ref": "#/$defs/ID"
        },
        "authorId": {
          "$ref": "#/$defs/ID"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "createdAt": {
          "$ref": "#/$defs/Time"
        }
      },
      "required": [
        "id",
        "guildId",
        "authorId",
        "sequence",
        "content",
        "createdAt"
      ]
    },
    "Time": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 UTC timestamp, e.g. 2026-09-09T10:00:00Z."
    },
    "ChatCreated": {
      "description": "Server broadcast to current guild members; deduplicate by message.id.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "message.created"
          ]
        },
        "message": {
          "$ref": "#/$defs/ChatMessage"
        }
      },
      "required": [
        "type",
        "message"
      ]
    },
    "ChatError": {
      "description": "Server protocol/business error; requestId is null for handshake errors.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "error"
          ]
        },
        "requestId": {
          "anyOf": [
            {
              "$ref": "#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "type": "string",
          "enum": [
            "UNAUTHENTICATED",
            "FORBIDDEN",
            "INVALID_MESSAGE",
            "RATE_LIMITED",
            "IDEMPOTENCY_CONFLICT"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "code",
        "message"
      ]
    },
    "RaidAuthenticate": {
      "description": "First client frame on a live raid socket. With socket tickets, accessToken carries the Gateway's single-use socket ticket instead of the player's access token. Do not persist or echo it.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "raid.authenticate"
          ]
        },
        "accessToken": {
          "type": "string",
          "writeOnly": true
        }
      },
      "required": [
        "type",
        "accessToken"
      ]
    },
    "RaidState": {
      "description": "The raid as it is now: sent after authentication and whenever the raid changes. Keep the highest version.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "raid.state"
          ]
        },
        "raidId": {
          "$ref": "#/$defs/ID"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "settling",
            "won",
            "failed",
            "cancelled"
          ]
        },
        "hp": {
          "type": "integer",
          "minimum": 0
        },
        "maxHp": {
          "type": "integer",
          "minimum": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "endsAt": {
          "$ref": "#/$defs/Time"
        },
        "participants": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/RaidContribution"
          }
        }
      },
      "required": [
        "type",
        "raidId",
        "status",
        "hp",
        "maxHp",
        "version",
        "endsAt",
        "participants"
      ]
    },
    "RaidContribution": {
      "description": "One participant's damage so far.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "userId": {
          "$ref": "#/$defs/ID"
        },
        "damageDealt": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "userId",
        "damageDealt"
      ]
    },
    "RaidError": {
      "description": "Sent before the server closes a live raid socket it cannot serve.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "raid.error"
          ]
        },
        "code": {
          "type": "string",
          "enum": [
            "UNAUTHENTICATED",
            "FORBIDDEN",
            "NOT_FOUND",
            "INVALID_MESSAGE",
            "DEPENDENCY_UNAVAILABLE"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "code",
        "message"
      ]
    }
  }
}
