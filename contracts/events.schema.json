        },
        "senderId": {
          "$ref": "#/$defs/ID"
        },
        "recipientId": {
          "$ref": "#/$defs/ID"
        }
      },
      "required": [
        "requestId",
        "senderId",
        "recipientId"
      ]
    },
    "MapEncounteredV1Data": {
      "description": "Payload for map.encountered.v1",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "userIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ID"
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "distanceMeters": {
          "type": "number",
          "minimum": 0,
          "maximum": 6
        }
      },
      "required": [
        "userIds",
        "distanceMeters"
      ]
    },
    "BattleRequestedV1Data": {
      "description": "Payload for battle.requested.v1",
      "type": "object",
