      "format": "uuid",
      "description": "UUID string identifying an existing resource."
    },
    "Time": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 UTC timestamp, e.g. 2026-09-09T10:00:00Z."
    },
    "Version": {
      "type": "integer",
      "minimum": 1
    },
    "UserPackageRegisteredV1Data": {
      "description": "Payload for user.package-registered.v1",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "userId": {
          "$ref": "#/$defs/ID"
        },
        "packageId": {
          "$ref": "#/$defs/ID"
        },
        "enrollmentVersion": {
          "$ref": "#/$defs/Version"
        },
        "createdAt": {
          "$ref": "#/$defs/Time"
        }
      },
      "required": [
        "userId",
        "packageId",
        "enrollmentVersion",
        "createdAt"
      ]
    },
    "FriendRequestedV1Data": {
      "description": "Payload for friend.requested.v1",
      "type": "object",
