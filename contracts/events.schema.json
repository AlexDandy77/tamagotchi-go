          "$ref": "#/$defs/ID"
        },
        "guildId": {
          "$ref": "#/$defs/ID"
        },
        "recipientIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ID"
          },
          "uniqueItems": true
        },
        "endsAt": {
          "$ref": "#/$defs/Time"
        }
      },
      "required": [
        "raidId",
        "guildId",
        "recipientIds",
        "endsAt"
      ]
    },
